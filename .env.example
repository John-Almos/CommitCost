# Local dev uses SQLite. Mock mode (npm run demo) needs nothing in this file.
# DATABASE_URL="file:./commitcost.db"

# --- Real mode (npm run sync, npm run analyze) ---
# AWS credentials come from the standard AWS chain: AWS_PROFILE, AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, SSO, or an instance role. Read-only: see the IAM policy in README.md.
# AWS_PROFILE=

# GitHub token with read-only access to the repo's contents and pull requests.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name
# GITHUB_BRANCH=main                  # defaults to the repo's default branch

# Cost-allocation tag to break costs down by (must be activated in AWS Billing).
# COMMITCOST_TAG_KEY=app
# COMMITCOST_COST_METRIC=UnblendedCost  # or AmortizedCost, NetUnblendedCost, NetAmortizedCost
# COMMITCOST_DAYS=90
# COMMITCOST_AWS_ACCOUNT_ID=           # label stored on records; optional

# --- Optional LLM explanations ---
# COMMITCOST_LLM=anthropic             # default: none (heuristic explanations only)
# ANTHROPIC_API_KEY=
# COMMITCOST_LLM_MODEL=claude-opus-5-5

# --- Hosted mode (companies connect their own AWS and GitHub) ---
# See docs/ONBOARDING.md. Leave these unset for local mode (no sign-in, one local user).
# COMMITCOST_URL=https://commitcost.example.com
# COMMITCOST_SECRET=                   # 32+ random characters; signs OAuth state
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY_PATH=./commitcost-app.pem   # or GITHUB_APP_PRIVATE_KEY with \n escapes
# GITHUB_APP_WEBHOOK_SECRET=
# COMMITCOST_AWS_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/commitcost   # the role CommitCost runs as
# COMMITCOST_CFN_TEMPLATE_URL=https://your-bucket.s3.amazonaws.com/commitcost-aws-role.json
# COMMITCOST_SYNC_INTERVAL_HOURS=6
